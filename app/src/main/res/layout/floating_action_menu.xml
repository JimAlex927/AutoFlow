<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fan_menu_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/fan_menu_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/fan_menu_card"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:background="@drawable/floating_menu_card_bg"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/fan_btn_panel"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_panel" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_log"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_log" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_session"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_session" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_tools"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_tools" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_pause"
            style="@style/FloatingPillMenuButton"
            android:visibility="gone">

            <ImageView
                android:id="@+id/fan_icon_pause"
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_pause" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_stop"
            style="@style/FloatingPillMenuButton"
            android:visibility="gone">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_stop" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_close"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_close" />
        </FrameLayout>
    </LinearLayout>

        <LinearLayout
            android:id="@+id/fan_tools_dock"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/floating_tool_dock_bg"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/fan_tool_capture"
                style="@style/FloatingDockMenuButton">

                <ImageView
                    style="@style/FloatingPillMenuIcon"
                    android:src="@drawable/ic_float_tool_capture" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fan_tool_back"
                style="@style/FloatingDockMenuButton">

                <ImageView
                    style="@style/FloatingPillMenuIcon"
                    android:src="@drawable/ic_float_tool_back" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fan_tool_close"
                style="@style/FloatingDockMenuButton">

                <ImageView
                    style="@style/FloatingPillMenuIcon"
                    android:src="@drawable/ic_float_menu_close" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
