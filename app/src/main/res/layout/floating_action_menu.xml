<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fan_menu_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/fan_menu_card"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:background="@drawable/floating_menu_card_bg"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/fan_btn_panel"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_panel" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_log"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_log" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_session"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_session" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_pause"
            style="@style/FloatingPillMenuButton"
            android:visibility="gone">

            <ImageView
                android:id="@+id/fan_icon_pause"
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_pause" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_stop"
            style="@style/FloatingPillMenuButton"
            android:visibility="gone">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_stop" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fan_btn_close"
            style="@style/FloatingPillMenuButton">

            <ImageView
                style="@style/FloatingPillMenuIcon"
                android:src="@drawable/ic_float_menu_close" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
