<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fan_menu_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/floating_quick_label_bg"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/fan_runtime_summary"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="5dp"
        android:text="运行中"
        android:textColor="#DCEEFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fan_btn_panel"
            style="@style/FloatingQuickActionButton"
            android:text="面板" />

        <TextView
            android:id="@+id/fan_btn_log"
            style="@style/FloatingQuickActionButton"
            android:text="日志" />

        <TextView
            android:id="@+id/fan_btn_pause"
            style="@style/FloatingQuickActionButton"
            android:text="暂停"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fan_btn_stop"
            style="@style/FloatingQuickDangerButton"
            android:text="停止"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fan_btn_close"
            style="@style/FloatingQuickActionButton"
            android:minWidth="34dp"
            android:text="×"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
