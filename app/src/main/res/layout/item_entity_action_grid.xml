<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_margin="4dp"
    android:background="@drawable/entity_action_tile_bg"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="5dp"
    android:paddingTop="7dp"
    android:paddingEnd="5dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/iv_entity_action_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:tint="#2E3138" />

    <TextView
        android:id="@+id/tv_entity_action_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#2E3138"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_entity_action_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#8A92A3"
        android:textSize="8sp" />
</LinearLayout>
