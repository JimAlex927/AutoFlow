<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_home_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_header_height"
        android:background="@drawable/home_header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="AutoMaster"
            android:src="@drawable/logo_seven_manifold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AutoMaster"
                android:textColor="@color/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="自动化工作台"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_toggle_float"
            android:layout_width="122dp"
            android:layout_height="40dp"
            android:background="@drawable/home_float_inactive_bg"
            android:drawableStart="@drawable/ic_float_menu_play"
            android:drawablePadding="7dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/main_float_start"
            android:textColor="@color/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_status_height"
        android:background="@drawable/home_status_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/circle_green" />

        <TextView
            android:id="@+id/tv_permission_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="权限检查中"
            android:textColor="@color/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_permission_sheet"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:background="@drawable/project_panel_toolbar_icon_bg"
            android:gravity="center"
            android:text="详情"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_permission_quick"
            android:layout_width="88dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/home_action_import_bg"
            android:gravity="center"
            android:text="一键获取"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_home_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/layout_home_quick_actions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="脚本"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="项目与任务"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_home_import_script"
                android:layout_width="86dp"
                android:layout_height="40dp"
                android:background="@drawable/home_action_import_bg"
                android:drawableStart="@drawable/ic_action_export"
                android:drawablePadding="5dp"
                android:drawableTint="@color/colorOnSurfaceVariant"
                android:gravity="center"
                android:text="导入"
                android:textColor="@color/colorOnSurface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_home_new_script"
                android:layout_width="92dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/home_action_new_bg"
                android:drawableStart="@drawable/ic_action_add"
                android:drawablePadding="5dp"
                android:drawableTint="@color/colorOnPrimary"
                android:gravity="center"
                android:text="新建"
                android:textColor="@color/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_panel_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_panel_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/project_panel_toolbar_icon_bg"
                android:contentDescription="返回"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                android:tint="@color/colorOnSurface"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_panel_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="项目"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_panel_breadcrumb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_panel_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/project_panel_toolbar_icon_bg"
                android:contentDescription="刷新"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/btn_panel_add"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/home_action_new_bg"
                android:contentDescription="添加"
                android:padding="10dp"
                android:src="@drawable/ic_action_add"
                android:tint="@color/colorOnPrimary" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_projects"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_projects"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layout_empty_projects"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:alpha="0.58"
                        android:contentDescription="暂无内容"
                        android:src="@drawable/ic_file_script"
                        android:tint="@color/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="暂无内容"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_empty_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="从新建脚本开始"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_empty_action"
                        style="@style/Widget.AtomMaster.Button.Primary"
                        android:layout_width="180dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="16dp"
                        android:text="创建" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/tv_panel_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:text="仅内测使用"
            android:textColor="@color/colorOnSurfaceDisabled"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_home_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_bottom_nav_height"
        android:background="@drawable/home_bottom_bar_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="6dp"
        android:paddingEnd="24dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/nav_home_projects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/home_bottom_nav_item_bg"
            android:drawableTop="@drawable/ic_file_script"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="项目"
            android:textColor="@color/home_bottom_nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_home_permissions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/home_bottom_nav_item_bg"
            android:drawableTop="@android:drawable/ic_menu_manage"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="权限"
            android:textColor="@color/home_bottom_nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_home_lab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="扩展"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nav_home_support"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/home_bottom_nav_item_bg"
            android:drawableTop="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="支持"
            android:textColor="@color/home_bottom_nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
